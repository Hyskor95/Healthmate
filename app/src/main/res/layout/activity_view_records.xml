<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".ViewRecordsActivity">
    <TextView
        android:id="@+id/tvRecordsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/health_records"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <EditText
        android:id="@+id/etSearchDate"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:hint="Search by date (e.g. 7/11/2026)"
        android:inputType="text"
        android:textColor="@android:color/white"
        android:textColorHint="#A0A0A0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvRecordsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button
        android:id="@+id/btnSearchDate"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="Search"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/accent_teal"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/etSearchDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button
        android:id="@+id/btnClearSearch"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="Clear Search"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/accent_teal"
        android:textColor="@android:color/black"
        app:layout_constraintTop_toBottomOf="@id/btnSearchDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ScrollView
        android:id="@+id/scrollRecords"
        android:contentDescription="@string/records_list_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnClearSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/recordsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>