<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    tools:context=".AddRecordActivity">
    <TextView
        android:id="@+id/tvAddRecordTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_record_title"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvDateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/date_label"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAddRecordTitle" />
    <EditText
        android:id="@+id/etRecordDate"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:hint="@string/date_hint"
        android:inputType="date"
        android:focusable="false"
        android:clickable="true"
        android:importantForAutofill="no"
        android:textColor="@android:color/white"
        android:textColorHint="#A0A0A0"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDateLabel" />
    <TextView
        android:id="@+id/tvStepsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/steps_label"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etRecordDate" />
    <EditText
        android:id="@+id/etSteps"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:hint="@string/steps_hint"
        android:inputType="number"
        android:importantForAutofill="no"
        android:textColor="@android:color/white"
        android:textColorHint="#A0A0A0"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStepsLabel" />
    <TextView
        android:id="@+id/tvCaloriesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/calories_label"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etSteps" />
    <EditText
        android:id="@+id/etCalories"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:hint="@string/calories_hint"
        android:inputType="number"
        android:importantForAutofill="no"
        android:textColor="@android:color/white"
        android:textColorHint="#A0A0A0"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCaloriesLabel" />
    <TextView
        android:id="@+id/tvWaterLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/water_label"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etCalories" />
    <EditText
        android:id="@+id/etWater"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:hint="@string/water_hint"
        android:inputType="number"
        android:importantForAutofill="no"
        android:textColor="@android:color/white"
        android:textColorHint="#A0A0A0"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWaterLabel" />
    <Button
        android:id="@+id/btnSaveRecord"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="@string/save_record"
        android:backgroundTint="@color/accent_teal"
        android:textColor="@android:color/black"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etWater" />



</androidx.constraintlayout.widget.ConstraintLayout>